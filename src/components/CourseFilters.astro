---
import { categories } from '../data/site';
const { target } = Astro.props;
---
<div class="filters" role="group" aria-label="Filter courses" data-filter-group={target}>
  <button class="chip" type="button" data-f="all" aria-pressed="true">All</button>
  {categories.map((c) => <button class="chip" type="button" data-f={c.id} aria-pressed="false">{c.label}</button>)}
</div>

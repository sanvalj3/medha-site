---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
---
<Base title="Page not found" description="The page you are looking for could not be found.">
  <section class="page-hero swoosh-bg" style="padding-block:120px">
    <div class="wrap" style="justify-items:start">
      <span class="eyebrow">Error 404</span>
      <h1>This page could not be found</h1>
      <p class="lede">The link may be old or mistyped. Try one of these instead.</p>
      <div class="cta-row"><a class="btn btn-primary" href={u('')}>Go to home</a><a class="btn btn-ghost" style="background:#FFFFFF" href={u('courses/')}>Browse courses</a><a class="btn btn-ghost" style="background:#FFFFFF" href={u('contact-us/')}>Contact us</a></div>
    </div>
  </section>
</Base>
